# Semantic FAQ Chatbot — configuration template.
# Copy to `.env` and adjust as needed. All values have sensible local defaults,
# so the app runs with no .env at all. Uncomment only what you want to override.

# --- Embedding model ---
# Any sentence-transformers model id. Default is lightweight & CPU-friendly.
# For multilingual support, e.g.: paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- Retrieval / confidence (cosine similarity, range roughly 0.0–1.0) ---
# NOTE: thresholds require empirical tuning; these are starting points, not truths.
# TOP_K=5
# SIMILARITY_THRESHOLD_HIGH=0.65    # >= this  -> confident answer
# SIMILARITY_THRESHOLD_LOW=0.45     # >= this  -> answer with caveat; below -> fallback

# --- Paths (override only for non-default layouts) ---
# DB_PATH=data/database/faq.db
# INDEX_DIR=data/indexes

# --- Logging ---
# LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR

# --- Hugging Face ---
# Load the embedding model from local cache only (no network). Set to 1 once the
# model is cached, or on networks that intercept TLS to huggingface.co (avoids a
# slow startup retry storm). Leave unset for a first-time download.
# HF_OFFLINE=0
