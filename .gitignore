# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# --- Environment / secrets ---
.env

# --- Slide-build output + temp files (created by scripts/build_slides.*) ---
# Decks now build next to their source markdown (e.g. docs/walkthrough/slides/);
# they are derived artifacts, so never commit them.
docs/**/slides/
docs/**/_build_*.md

# --- App-generated artifacts (derived; not committed) ---
data/database/*.db
data/database/*.sqlite3
data/indexes/*.faiss
data/indexes/*.pkl
data/indexes/*.json
logs/
*.log

# --- Tooling / IDE / OS ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- ML model cache (downloaded, large) ---
.cache/
